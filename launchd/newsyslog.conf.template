# Blossom farm kit - log rotation for /opt/farm/logs (read by newsyslog, which
# macOS runs every hour). Written by install.sh; re-running it rewrites this file.
#
# A log is rotated when it is larger than 10 MB; ten rotated files are kept,
# compressed. The farm programs append line by line and open the file each
# time (services/farm-run.sh), so no program is signalled or restarted (flag N).
#
# logfilename                               [owner:group]                    mode count size(KB) when flags
@FARM_ROOT@/logs/mongodb.log               @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/hub.log                   @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/provider.log              @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/provider-gate.log         @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/keep-available.log        @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/cloudflared.log           @SERVICE_USER@:@SERVICE_GROUP@   640  10    10240    *    NZ
@FARM_ROOT@/logs/restart-server.log        root:@SERVICE_GROUP@             640  10    10240    *    NZ
@FARM_ROOT@/logs/firewall.log              root:@SERVICE_GROUP@             640  5     1024     *    NZ
