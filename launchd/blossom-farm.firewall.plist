<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Blossom farm kit. install.sh fills in the placeholders of this template
     and writes the result to /Library/LaunchDaemons. Do not edit the
     installed file: install.sh rewrites it. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>blossom-farm.firewall</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@FARM_ROOT@/services/farm-run.sh</string>
        <string>--log</string>
        <string>@FARM_ROOT@/logs-root/firewall.log</string>
        <string>--log-max-kb</string>
        <string>1024</string>
        <string>--log-keep</string>
        <string>5</string>
        <string>--</string>
        <string>/bin/bash</string>
        <string>@FARM_ROOT@/services/farm-firewall.sh</string>
        <string>load</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>FARM_PF_RULES</key>
        <string>@FARM_ROOT@/config/pf.rules</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>@FARM_ROOT@/services</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>Umask</key>
    <integer>23</integer>
</dict>
</plist>
