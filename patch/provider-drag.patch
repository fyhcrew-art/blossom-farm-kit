+// sourceOffer is sent with every answer of this modified provider, so that
+// whoever uses it over a network is told where to get its complete source
+// (GNU AGPL v3.0, section 13). Each release there carries the source archive
+// of the binary published with it. If you change this program further and
+// let others use it over a network, point this at YOUR source.
+const sourceOffer = "https://github.com/fyhcrew-art/blossom-farm-kit/releases"
+
 func HandleRequests() *gin.Engine {
 	r := gin.Default()
+	r.Use(func(c *gin.Context) {
+		c.Header("X-Source-Code", sourceOffer)
+		c.Next()
+	})
 	rConfig := cors.DefaultConfig()
 	rConfig.AllowAllOrigins = true
 	rConfig.AllowHeaders = []string{"Authorization", "Content-Type"}
