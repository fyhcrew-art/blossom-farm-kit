# The patch must keep LF line ends or it does not apply.
*.patch   text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
# Windows PowerShell 5.1 reads both; CRLF is kinder to Notepad on the farm PC.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.psd1    text eol=crlf
LICENSE   text eol=lf
NOTICE    text eol=lf
*.sh      text eol=lf
LICENSE-AGPL-3.0 text eol=lf
*.awk     text eol=lf
*.plist   text eol=lf
*.template text eol=lf
# The first file of the one-command setup is fetched by itself from
# raw.githubusercontent.com and pinned by its SHA-256: the same bytes everywhere.
bootstrap.ps1 text eol=lf
*.sha256  text eol=lf
